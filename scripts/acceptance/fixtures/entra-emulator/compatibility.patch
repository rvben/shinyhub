+			resp, body := postForm(t, http.DefaultClient, endpoint, grant)
+			if resp.StatusCode != http.StatusOK {
+				t.Fatalf("legacy grant failed after migration: %v", body)
+			}
+			if _, ok := decodeJWTPayload(t, body["id_token"].(string))["sid"]; ok {
