diff --git a/internal/server/access_token_version_test.go b/internal/server/access_token_version_test.go
new file mode 100644
index 0000000..80a83fd
--- /dev/null
+++ b/internal/server/access_token_version_test.go
@@ -0,0 +1,60 @@
+package server
+
+import (
+	"net/http"
+	"net/url"
+	"testing"
+
+	"github.com/calvinchengx/entra-emulator/internal/store"
+)
+
+// accessTokenAcceptedVersion through the admin API: validated, shown on the
+// app, and an app set to 2 gets aud = its client id in client-credentials
+// tokens even when the scope names its App ID URI.
+func TestAccessTokenAcceptedVersion(t *testing.T) {
+	hts, _, _ := newTestServer(t)
+	appURL := hts.URL + "/admin/api/apps/" + daemonID
+	tokenURL := hts.URL + "/" + tenant + "/oauth2/v2.0/token"
+
+	clientCredentialsAud := func() any {
+		t.Helper()
+		resp, body := postForm(t, http.DefaultClient, tokenURL, url.Values{
+			"grant_type":    {"client_credentials"},
+			"client_id":     {daemonID},
+			"client_secret": {store.SeedDaemonSecret},
+			"scope":         {"api://" + daemonID + "/.default"},
+		})
+		if resp.StatusCode != 200 {
+			t.Fatalf("token: %d %v", resp.StatusCode, body)
+		}
+		return decodeJWTPayload(t, body["access_token"].(string))["aud"]
+	}
+
+	if aud := clientCredentialsAud(); aud != "api://"+daemonID {
+		t.Fatalf("default aud = %v, want api://%s", aud, daemonID)
+	}
+
+	if code, body := patchJSON(t, appURL, map[string]any{"accessTokenAcceptedVersion": 3}); code != 400 {
+		t.Fatalf("version 3 should be rejected: %d %v", code, body)
+	}
+
+	code, app := patchJSON(t, appURL, map[string]any{"accessTokenAcceptedVersion": 2})
+	if code != 200 || app["accessTokenAcceptedVersion"] != float64(2) {
+		t.Fatalf("set version 2: %d %v", code, app)
+	}
+	if aud := clientCredentialsAud(); aud != daemonID {
+		t.Fatalf("version 2 aud = %v, want %s", aud, daemonID)
+	}
+
+	code, app = patchJSON(t, appURL, map[string]any{"accessTokenAcceptedVersion": 0})
+	if code != 200 || app["accessTokenAcceptedVersion"] != nil {
+		t.Fatalf("clear version: %d %v", code, app)
+	}
+
+	code, created := postJSON(t, hts.URL+"/admin/api/apps", map[string]any{
+		"displayName": "v2 app", "accessTokenAcceptedVersion": 2,
+	})
+	if code != 201 || created["accessTokenAcceptedVersion"] != float64(2) {
+		t.Fatalf("create with version 2: %d %v", code, created)
+	}
+}
diff --git a/internal/server/authorize_openid_test.go b/internal/server/authorize_openid_test.go
new file mode 100644
index 0000000..366e77b
--- /dev/null
+++ b/internal/server/authorize_openid_test.go
@@ -0,0 +1,79 @@
+package server
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+// A code-flow request without openid (e.g. Swagger UI asking only for an API
+// scope) is accepted, like Entra, and the token response has no id_token.
+func TestAuthorizeCodeFlowWithoutOpenID(t *testing.T) {
+	hts, _, _ := newTestServer(t)
+	authorize := hts.URL + "/" + tenant + "/oauth2/v2.0/authorize"
+	authURL := authorize + "?" + url.Values{
+		"client_id": {spaID}, "response_type": {"code"}, "redirect_uri": {redirect},
+		"scope": {"User.Read"}, "state": {"s"},
+		"code_challenge": {pkceChallenge(verifierPK)}, "code_challenge_method": {"S256"},
+	}.Encode()
+	client := noRedirectJar()
+
+	// Reaches the sign-in page instead of redirecting with invalid_scope.
+	state := authPickerState(t, client, authURL)
+	resp, err := client.PostForm(authorize, url.Values{"__ee_state": {state}, "__ee_user": {aliceID}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	loc, _ := url.Parse(resp.Header.Get("Location"))
+	code := loc.Query().Get("code")
+	if resp.StatusCode != 302 || code == "" {
+		t.Fatalf("want 302 with code, got %d %s", resp.StatusCode, resp.Header.Get("Location"))
+	}
+
+	tokResp, err := http.PostForm(hts.URL+"/"+tenant+"/oauth2/v2.0/token", url.Values{
+		"grant_type": {"authorization_code"}, "client_id": {spaID}, "code": {code},
+		"redirect_uri": {redirect}, "code_verifier": {verifierPK},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tokResp.Body.Close()
+	var body map[string]any
+	_ = json.NewDecoder(tokResp.Body).Decode(&body)
+	if tokResp.StatusCode != 200 || body["access_token"] == nil {
+		t.Fatalf("want access token, got %d %v", tokResp.StatusCode, body)
+	}
+	if _, ok := body["id_token"]; ok {
+		t.Fatal("no openid requested, so no id_token expected")
+	}
+}
+
+// An id_token is still never issued without openid, and an empty scope is refused.
+func TestAuthorizeOpenIDStillRequiredForIDTokenAndScopeRequired(t *testing.T) {
+	hts, _, _ := newTestServer(t)
+	authorize := hts.URL + "/" + tenant + "/oauth2/v2.0/authorize"
+	cases := map[string]url.Values{
+		"id_token without openid": {
+			"client_id": {spaID}, "response_type": {"id_token"}, "redirect_uri": {redirect},
+			"scope": {"User.Read"}, "state": {"s"}, "nonce": {"n"},
+		},
+		"empty scope": {
+			"client_id": {spaID}, "response_type": {"code"}, "redirect_uri": {redirect},
+			"scope": {""}, "state": {"s"},
+			"code_challenge": {pkceChallenge(verifierPK)}, "code_challenge_method": {"S256"},
+		},
+	}
+	for name, q := range cases {
+		resp, err := noRedirectJar().Get(authorize + "?" + q.Encode())
+		if err != nil {
+			t.Fatal(err)
+		}
+		resp.Body.Close()
+		if resp.StatusCode != 302 || !strings.Contains(resp.Header.Get("Location"), "error=invalid_scope") {
+			t.Fatalf("%s: want redirect with invalid_scope, got %d %s", name, resp.StatusCode, resp.Header.Get("Location"))
+		}
+	}
+}
diff --git a/internal/server/frontchannel_correlation_test.go b/internal/server/frontchannel_correlation_test.go
