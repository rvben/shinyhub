+	for _, grant := range []url.Values{
+		{"grant_type": {"authorization_code"}, "code": {"legacy-code"}, "client_id": {spaID}, "redirect_uri": {redirect}},
+		{"grant_type": {"refresh_token"}, "refresh_token": {"legacy-refresh"}, "client_id": {spaID}},
+	} {
