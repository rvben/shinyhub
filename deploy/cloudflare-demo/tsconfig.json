{
  "compilerOptions": {
    // src/edge-policy.ts is imported both by the bundled Worker and by
    // node --test, whose ESM resolver requires the extension in the specifier.
    "allowImportingTsExtensions": true,
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts"],
  // Tests run on Node (node --test, which strips types itself), not on the
  // Workers runtime this config describes. Typechecking them here would fail on
  // node: imports that the Worker deliberately has no types for.
  "exclude": ["src/**/*.test.ts"]
}
