# Copy to .env on the demo host and keep that file out of version control.
# Pin release images before each rollout; do not operate the public demo on
# floating tags.
SHINYHUB_IMAGE=ghcr.io/rvben/shinyhub:0.11.8
SHINYHUB_PYTHON_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm-slim
SHINYHUB_R_IMAGE=rocker/shiny:4.5.1

SHINYHUB_DATA_ROOT=/srv/shinyhub-demo
DOCKER_GID=0

# Generate both values independently with: openssl rand -hex 32
SHINYHUB_AUTH_SECRET=replace-with-64-random-hex-characters
SHINYHUB_DEPLOY_TOKEN=shk_replace-with-a-random-deploy-token

# Create a GitHub OAuth app with this callback URL:
# https://demo.shinyhub.dev/api/auth/github/callback
SHINYHUB_GITHUB_CLIENT_ID=replace-me
SHINYHUB_GITHUB_CLIENT_SECRET=replace-me

# Used by Caddy for ACME expiry notices.
ACME_EMAIL=ops@shinyhub.dev
