{
  "name": "shinyhub",
  "version": "0.24.2",
  "private": true,
  "description": "Dev tooling for the ShinyHub dashboard UI: jsdom unit tests for the embedded JS modules (the app itself is a Go binary; this package is never published to npm).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test 'internal/ui/jstests/*.test.js'",
    "test:acceptance": "node scripts/acceptance-e2e.mjs",
    "test:recovery": "node scripts/recovery-e2e.mjs",
    "test:live-upgrade": "node scripts/browser-lifecycle-e2e.mjs --live-upgrade"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "jsdom": "^25.0.1",
    "oxlint": "1.92.0",
    "terser": "5.51.2"
  }
}
